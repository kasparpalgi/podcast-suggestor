# --- Public (reach the browser) ---
PUBLIC_BASE_URL="https://podmatch.com"
PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Server only ---
SUPABASE_SECRET_API="sb_secret_xxx"      # privileged writes / cron (bypasses RLS)
RESEND_API_KEY="re_xxx"
RESEND_VERIFIED_DOMAIN="domain.com"      # verified "from" domain
PODSCAN_API_KEY="xxx"
PODSCAN_FIXTURES=""                      # DEV ONLY: "1" serves hand-built podcasts instead of calling Podscan ("" empty default)
OPENROUTER_API_KEY="sk-or-xxx"
OPENROUTER_MODEL="google/gemini-2.5-flash-lite"CRON_SECRET="long-random-string"   # bearer for /api/signups.csv and the weekly cron
